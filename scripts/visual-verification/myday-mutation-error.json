{
  "name": "My Day mutation error bar",
  "startUri": "glasswork://myday",
  "tasks": [
    {
      "id": "vv-vanishing-suggestion",
      "title": "Vanishing suggestion task",
      "description": "A high-priority suggestion whose file is re-identified out from under the bound row, so the add fails with a reported error instead of crashing.",
      "status": "todo",
      "priority": "high"
    }
  ],
  "actions": [
    {
      "type": "select",
      "automationId": "NavMyDay",
      "timeoutMilliseconds": 10000
    },
    {
      "type": "wait-for",
      "name": "Add Vanishing suggestion task to My Day",
      "timeoutMilliseconds": 10000
    },
    {
      "type": "replace-task-text",
      "taskId": "vv-vanishing-suggestion",
      "oldValue": "id: vv-vanishing-suggestion",
      "value": "id: vv-reidentified-suggestion"
    },
    {
      "type": "invoke",
      "name": "Add Vanishing suggestion task to My Day",
      "timeoutMilliseconds": 10000
    },
    {
      "type": "wait-for",
      "automationId": "MyDayError",
      "timeoutMilliseconds": 10000
    }
  ],
  "captures": [
    {
      "name": "myday-mutation-error",
      "waitMilliseconds": 1200
    }
  ]
}

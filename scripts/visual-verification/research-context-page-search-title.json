    {
      "type": "assert-name",
      "automationId": "ResearchCurateContext",
      "value": "Choose context pages"
    },
    {
      "type": "invoke",
      "automationId": "ResearchCurateContext"
    },
    {
      "type": "assert-name",
      "automationId": "ResearchContextDrawerTitle",
      "value": "Choose context pages"
    },
    {
      "type": "assert-focused",
      "automationId": "ResearchContextDrawerClose"
    },
    {
      "type": "set-value",
      "automationId": "ResearchContextPageSearchBox",
      "value": "cOnTrAcTs"
    },
    {
      "type": "wait-for",
      "name": "Include Callback Contracts, stable ID source-callback-contracts, in durable Research context"
    },
    {
      "type": "assert-not-present",
      "name": "Include Polling Semantics, stable ID stable-beta-42, in durable Research context"
    },
    {
      "type": "assert-name",
      "automationId": "ResearchContextSelectionSummary",
      "value": "1 of 2 eligible pages included"
    },
    {
      "type": "assert-disabled",
      "automationId": "ShellNavigation"
    }
  ],
  "captures": [
    {
      "name": "research-context-page-search-title",
      "waitMilliseconds": 500
    }
  ]

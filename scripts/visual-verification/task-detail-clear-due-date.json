{
  "name": "Task Detail clear due date",
  "theme": "dark",
  "tasks": [
    {
      "id": "vv-detail-stale-due",
      "title": "Parked detail item",
      "description": "Moved back to the ADO backlog. Clearing the due date from Task Detail must persist and stop the Overdue promotion into My Day.",

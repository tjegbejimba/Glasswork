{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glasswork (Tauri spike)",
  "version": "0.1.0",
  "identifier": "com.glasswork.spike.tauri",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://127.0.0.1:8935"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Glasswork -- Tauri/Rust Core spike (#372)",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSTEST0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <!--
      Referenced as a real assembly (not just build-order) so unit tests can
      exercise internal pure logic (e.g. CanvasVersionDriftDetector) directly,
      alongside the existing black-box HTTP boundary tests that spawn the host
      as a separate process.
    -->
    <ProjectReference Include="..\..\tools\Glasswork.CanvasHost\Glasswork.CanvasHost.csproj" />
    <ProjectReference Include="..\..\src\Glasswork.Core\Glasswork.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
</Project>

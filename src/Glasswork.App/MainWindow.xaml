<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Glasswork.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Glasswork"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Glasswork"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="ShellRoot"
        RowDefinitions="48,*"
        GettingFocus="ShellRoot_GettingFocus">
        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="ShellTitleBar"
            Title="Glasswork"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <ContentControl
            x:Name="ShellContent"
            Grid.Row="1"
            AutomationProperties.AutomationId="ShellContent"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <StackPanel
                    x:Name="StartupLoadingPanel"
                    AutomationProperties.AutomationId="StartupLoadingPanel"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    VerticalAlignment="Center">
                    <ProgressRing
                        Width="40"
                        Height="40"
                        AutomationProperties.Name="Loading Glasswork"
                        IsActive="True" />
                    <TextBlock
                        AutomationProperties.AutomationId="StartupLoadingText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Loading your tasks…" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.7"
                        Text="You can move or close this window while Glasswork gets ready." />
                </StackPanel>

                <StackPanel
                    x:Name="StartupErrorPanel"
                    AutomationProperties.AutomationId="StartupErrorPanel"
                    HorizontalAlignment="Center"
                    MaxWidth="520"
                    Spacing="12"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <FontIcon
                        FontSize="36"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;" />
                    <TextBlock
                        AutomationProperties.AutomationId="StartupErrorText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Glasswork couldn’t load your tasks." />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.75"
                        Text="Check that your Vault is available, then try again."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="StartupRetryButton"
                        AutomationProperties.AutomationId="StartupRetryButton"
                        HorizontalAlignment="Center"
                        Click="StartupRetryButton_Click"
                        Content="Try again"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <Grid
                    x:Name="ReadyShell"
                    AutomationProperties.AutomationId="StartupReadyShell"
                    RowDefinitions="*,Auto"
                    Visibility="Collapsed">
                    <NavigationView
                        x:Name="NavView"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="ShellNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="NavView_SelectionChanged"
                        ItemInvoked="NavView_ItemInvoked">
                        <NavigationView.MenuItems>
                            <NavigationViewItem
                                x:Name="NavMyDay"
                                AutomationProperties.AutomationId="NavMyDay"
                                Content="My Day"
                                IsSelected="True"
                                Tag="myday">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE706;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem AutomationProperties.AutomationId="NavBacklog" Content="Backlog" Tag="backlog">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8FD;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem AutomationProperties.AutomationId="NavWorkLog" Content="Work Log" Tag="worklog">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE9D5;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem
                                x:Name="NavResearch"
                                AutomationProperties.AutomationId="NavResearch"
                                Content="Research"
                                Tag="research">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE82D;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.MenuItems>
                        <NavigationView.FooterMenuItems>
                            <NavigationViewItem AutomationProperties.AutomationId="NavFeedback" Content="Feedback" Tag="feedback">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xED15;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.FooterMenuItems>
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0">
                                <InfoBar x:Name="DeepLinkErrorBar"
                                         AutomationProperties.AutomationId="DeepLinkErrorBar"
                                         IsOpen="False"
                                         IsClosable="True"
                                         Severity="Warning"
                                         Margin="8,8,8,0" />
                                <InfoBar x:Name="SupplementalStatusBar"
                                         AutomationProperties.AutomationId="SupplementalStatusBar"
                                         IsOpen="False"
                                         IsClosable="False"
                                         Severity="Informational"
                                         Margin="8,8,8,0"
                                         Title="Finishing background data">
                                    <InfoBar.ActionButton>
                                        <Button x:Name="SupplementalRetryButton"
                                                AutomationProperties.AutomationId="SupplementalRetryButton"
                                                Click="SupplementalRetryButton_Click"
                                                Content="Try again"
                                                Visibility="Collapsed" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </StackPanel>
                            <Frame x:Name="NavFrame" Grid.Row="1" AutomationProperties.AutomationId="ContentFrame">
                                <Frame.ContentTransitions>
                                    <TransitionCollection>
                                        <NavigationThemeTransition />
                                    </TransitionCollection>
                                </Frame.ContentTransitions>
                            </Frame>
                        </Grid>
                    </NavigationView>

                    <Border Grid.Row="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,4">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="14">
                            <TextBlock Grid.Column="0" x:Name="StatusVaultText"
                                       AutomationProperties.AutomationId="StatusVaultText"
                                       FontSize="11" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="StatusTaskCountText"
                                       AutomationProperties.AutomationId="StatusTaskCountText"
                                       FontSize="11" Opacity="0.7"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="StatusWatcherDot" Width="8" Height="8"
                                         Fill="#107C10" />
                                <TextBlock x:Name="StatusWatcherText" Text="watching"
                                           FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" x:Name="StatusLastReloadText"
                                       FontSize="11" Opacity="0.7"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" x:Name="StatusVersionText"
                                       FontSize="11" Opacity="0.55"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ContentControl>

        <ContentControl
            x:Name="ModalOverlayHost"
            Grid.RowSpan="2"
            AutomationProperties.AutomationId="ShellModalOverlay"
            HorizontalContentAlignment="Stretch"
            IsTabStop="False"
            TabFocusNavigation="Cycle"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glasswork.Pages.MyDayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Glasswork.Converters"
    xmlns:controls="using:Glasswork.Controls"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolVisibilityConverter x:Key="BoolVis" />
        <conv:SubtaskSegmentBrushConverter x:Key="SegBrush" />
        <conv:DueUrgencyBrushConverter x:Key="DueBg" />
        <conv:DueUrgencyForegroundBrushConverter x:Key="DueFg" />

        <!-- The InfoBar close button is a template part, so it inherits the framework's
             generic "Close" name and is indistinguishable from the window caption's Close
             button to UI Automation (and to a screen-reader user). Naming it makes the
             error bar's dismissal both announceable and addressable by the visual
             verification harness, which searches the whole window by name. -->
        <Style x:Key="MyDayErrorCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource InfoBarCloseButtonStyle}">
            <Setter Property="AutomationProperties.AutomationId" Value="MyDayErrorClose" />
            <Setter Property="AutomationProperties.Name" Value="Dismiss My Day error" />
        </Style>
    </Page.Resources>

    <Grid Padding="32" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">

        <!-- Header (with update-available announce InfoBar above it) -->
        <StackPanel Grid.Row="0">
            <!-- Update-available announce: dismissible Informational bar routing to Settings (issue #241) -->
            <InfoBar x:Name="UpdateHint"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"
                     Title="Update available"
                     Margin="0,0,0,12"
                     CloseButtonClick="UpdateHint_CloseButtonClick">
                <InfoBar.ActionButton>
                    <Button Content="Go to Settings" Click="UpdateHintGoToSettings_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="My Day" />
                    <TextBlock Text="{x:Bind TodayDate}" Opacity="0.6" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Click="RefreshButton_Click"
                        VerticalAlignment="Top" Margin="0,4,0,0"
                        ToolTipService.ToolTip="Refresh from vault">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Mutation failures (revision conflict / missing / read-only), mirroring PlannerPage -->
            <InfoBar x:Name="ErrorBar"
                     AutomationProperties.AutomationId="MyDayError"
                     IsOpen="False"
                     IsClosable="True"
                     CloseButtonStyle="{StaticResource MyDayErrorCloseButtonStyle}"
                     CloseButtonClick="ErrorBar_CloseButtonClick"
                     Severity="Error"
                     Title="Could not update My Day"
                     Margin="0,12,0,0" />
        </StackPanel>

        <!-- Today's tasks header -->
        <TextBlock x:Name="TodayHeader" Grid.Row="1" Text="Today's tasks"
                   AutomationProperties.AutomationId="MyDayTodayHeader"
                   Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />

        <!-- Clipboard hint: brief feedback when an agent-command line is copied -->
        <InfoBar x:Name="ClipboardHint"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Success"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,0,0,8" />

        <ListView
            Grid.Row="2"
            x:Name="TodayList"
            AutomationProperties.AutomationId="MyDayTaskList"
            ItemsSource="{x:Bind ViewModel.TodayTasks}"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            MinHeight="320"
            Margin="0,16,0,0">
            <ListView.KeyboardAccelerators>
                <KeyboardAccelerator Key="O" Modifiers="Control,Shift" Invoked="OpenInObsidian_Accelerator" />
            </ListView.KeyboardAccelerators>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,8" RowDefinitions="Auto,Auto,Auto,Auto"
                          DoubleTapped="TaskRow_DoubleTapped"
                          ContextRequested="TaskRow_ContextRequested"
                          Background="Transparent">
                        <!-- Actionable Task/Bug title row. Parent Tasks use the dedicated
                             context row below so their signals never look like leaf urgency. -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                              Visibility="{Binding ShowLeafCompleteAffordance, Converter={StaticResource BoolVis}}">
                            <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0">
                                <!-- Leaf complete affordance. Parent Tasks use the context row. -->
                                <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"
                                          IsChecked="{Binding IsDone, Mode=OneWay}"
                                          Style="{StaticResource CircleCheckBoxStyle}"
                                          Visibility="{Binding ShowLeafCompleteAffordance, Converter={StaticResource BoolVis}}"
                                          IsHitTestVisible="False" IsTabStop="False" />
                                <Button Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Visibility="{Binding ShowLeafCompleteAffordance, Converter={StaticResource BoolVis}}"
                                        Click="CompleteTask_Click" />
                                <!-- Parent marker retained for compatibility with the leaf template. -->
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;" FontSize="14"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7"
                                          Visibility="{Binding IsMyDayContainer, Converter={StaticResource BoolVis}}" />
                            </Grid>
                            <HyperlinkButton Grid.Column="1" Content="{Binding Title}"
                                             Click="OpenTask_Click"
                                             Padding="0" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Left" />
                            <!-- Priority chip (high/urgent only) -->
                            <Border Grid.Column="2" Style="{StaticResource ChipBorderStyle}"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{Binding HasPriorityChip, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Priority}" Style="{StaticResource ChipTextStyle}" />
                            </Border>
                            <!-- Due chip -->
                            <Border Grid.Column="3" Style="{StaticResource ChipBorderStyle}"
                                    Background="{Binding DueUrgency, Converter={StaticResource DueBg}}"
                                    Visibility="{Binding HasDue, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding DueChipText}" Style="{StaticResource ChipTextStyle}"
                                           Foreground="{Binding DueUrgency, Converter={StaticResource DueFg}}" />
                            </Border>
                            <Button Grid.Column="4" Click="RemoveFromDay_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0"
                                    AutomationProperties.Name="{Binding RemoveFromMyDayLabel}"
                                    ToolTipService.ToolTip="Remove from My Day">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="13" />
                            </Button>
                            <!-- More menu: copy agent-command lines without leaving My Day -->
                            <Button Grid.Column="5" Background="Transparent" BorderThickness="0"
                                    Padding="6,2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="More actions">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="13" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copy 'Start work' command" Click="CopyStartWork_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy 'Resume' command" Click="CopyResume_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy 'Wrap up' command" Click="CopyWrapUp_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <!-- Nearest Parent context. Higher ancestors are compressed into one
                             breadcrumb; no ancestor is materialized as another card. -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto"
                              Visibility="{Binding IsMyDayParentContextRow, Converter={StaticResource BoolVis}}">
                            <FontIcon Grid.Column="0"
                                      FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE8B7;"
                                      FontSize="14"
                                      Margin="0,2,10,0"
                                      VerticalAlignment="Top"
                                      Opacity="0.7" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding MyDayAncestorBreadcrumb}"
                                           FontSize="11"
                                           Opacity="0.62"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasMyDayAncestorBreadcrumb, Converter={StaticResource BoolVis}}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <HyperlinkButton Content="{Binding Title}"
                                                     Click="OpenTask_Click"
                                                     Padding="0"
                                                     VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ChipBorderStyle}">
                                        <TextBlock Text="{Binding MyDaySourceKindBadge}"
                                                   Style="{StaticResource ChipTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Parent coordination"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Opacity="0.7"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsParentCoordinationRow, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding MyDayParentDueContext}"
                                               FontSize="11"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Visibility="{Binding HasMyDayParentDueContext, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="{Binding MyDayParentPriorityContext}"
                                               FontSize="11"
                                               Opacity="0.72"
                                               Visibility="{Binding HasMyDayParentPriorityContext, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="{Binding ChildActivitySummaryStatusLabel}"
                                               FontSize="11"
                                               Opacity="0.72"
                                               Visibility="{Binding HasChildActivitySummaryStatus, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Click="RemoveFromDay_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding RemoveFromMyDayLabel}"
                                    ToolTipService.ToolTip="Remove Parent group from My Day">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="13" />
                            </Button>
                            <Button Grid.Column="3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Parent actions">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="13" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copy 'Start work' command" Click="CopyStartWork_Click" />
                                        <MenuFlyoutItem Text="Copy 'Resume' command" Click="CopyResume_Click" />
                                        <MenuFlyoutItem Text="Copy 'Wrap up' command" Click="CopyWrapUp_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Copy 'Refresh summary' command" Click="CopyRefreshSummary_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <!-- Card details (active + not collapsed) -->
                        <StackPanel Grid.Row="1" Spacing="6" Margin="32,6,0,2"
                                    Visibility="{Binding ShowCardDetails, Converter={StaticResource BoolVis}}">
                            <!-- Segmented progress bar (≤12 subtasks) -->
                            <ItemsControl ItemsSource="{Binding Subtasks}"
                                          Visibility="{Binding UseSegmentedBar, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="22" Height="6" CornerRadius="2"
                                                Background="{Binding Converter={StaticResource SegBrush}}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Continuous progress bar (≥13 subtasks) -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                  Visibility="{Binding UseContinuousBar, Converter={StaticResource BoolVis}}">
                                <ProgressBar Grid.Column="0" Minimum="0" Maximum="1"
                                             Value="{Binding ProgressFraction}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}"
                                           FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Current step -->
                            <Grid ColumnDefinitions="Auto,*"
                                  Visibility="{Binding HasCurrentStep, Converter={StaticResource BoolVis}}">
                                <Border Grid.Column="0" Width="3" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="1.5" Margin="0,1,8,1" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentStepText}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Blocker -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding HasBlocker, Converter={StaticResource BoolVis}}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="11"
                                          Foreground="#C50F1F" />
                                <TextBlock Text="{Binding FirstBlockerText}" FontSize="12"
                                           Foreground="#C50F1F" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!-- Blurb -->
                            <TextBlock Text="{Binding BlurbPreview}"
                                       AutomationProperties.Name="{Binding BlurbPreview}"
                                       Opacity="0.8"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasBlurb, Converter={StaticResource BoolVis}}" />
                        </StackPanel>

                        <!-- Today's subtasks (ADR 0008): flagged or due-today subtasks rendered
                             inline beneath the parent. Visible whenever any qualify, even when
                             the parent's card details are collapsed, since these subtasks are
                             the reason this parent appears in My Day. Placed in its own row so
                             it stacks below card details rather than overlapping them. -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding TodaysSubtasks}"
                                      Visibility="{Binding HasTodaysSubtasks, Converter={StaticResource BoolVis}}"
                                      Margin="32,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,2" ColumnDefinitions="Auto,*">
                                        <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons"
                                                  Glyph="&#xE73E;" FontSize="11"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Opacity="0.55" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                   FontSize="12" Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Today's children (ADR 0026): in-My-Day cross-file child Tasks rendered
                             beneath their nearest Parent. Each child is a full Task — complete via
                             the circle, open via the title. Hidden when the container is collapsed. -->
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding TodaysChildren}"
                                      Visibility="{Binding ShowTodaysChildren, Converter={StaticResource BoolVis}}"
                                      Margin="32,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,3" ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent">
                                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsDone, Mode=OneWay}"
                                                      Style="{StaticResource CircleCheckBoxStyle}"
                                                      IsHitTestVisible="False" IsTabStop="False" />
                                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    Click="CompleteTask_Click" />
                                        </Grid>
                                        <HyperlinkButton Grid.Column="1" Content="{Binding Title}"
                                                         Click="OpenTask_Click"
                                                         Padding="0" VerticalAlignment="Center"
                                                         HorizontalAlignment="Stretch"
                                                         HorizontalContentAlignment="Left" />
                                        <Border Grid.Column="2" Style="{StaticResource ChipBorderStyle}"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                Visibility="{Binding HasPriorityChip, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Priority}" Style="{StaticResource ChipTextStyle}" />
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource ChipBorderStyle}"
                                                Background="{Binding DueUrgency, Converter={StaticResource DueBg}}"
                                                Visibility="{Binding HasDue, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding DueChipText}" Style="{StaticResource ChipTextStyle}"
                                                       Foreground="{Binding DueUrgency, Converter={StaticResource DueFg}}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state: shown when My Day has no tasks. -->
        <controls:EmptyState
            x:Name="EmptyStateView"
            AutomationProperties.AutomationId="MyDayEmptyState"
            Grid.Row="2"
            Margin="0,16,0,0"
            Glyph="&#xE706;"
            Headline="Today is open."
            Body="Nothing's been pulled into your day yet. Carry over yesterday's unfinished work, or pick something from the Backlog."
            CtaText="Open Backlog"
            CtaClicked="EmptyState_OpenBacklog"
            Visibility="Collapsed" />

        <!-- ADR 0008: separate "Flagged subtasks" section removed; parents are now virtually
             promoted into Today's tasks above with qualifying subtasks rendered inline. -->

        <!-- Recently Completed (today, was on My Day) -->
        <StackPanel x:Name="RecentlyCompletedHeader" Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,24,0,8" Visibility="Collapsed">
            <TextBlock Text="Recently completed" Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.75" />
            <TextBlock Text="{x:Bind ViewModel.RecentlyCompletedTasks.Count, Mode=OneWay}" Opacity="0.5" VerticalAlignment="Center" />
        </StackPanel>

        <ListView x:Name="RecentlyCompletedList" Grid.Row="5" Visibility="Collapsed"
                  ItemsSource="{x:Bind ViewModel.RecentlyCompletedTasks}" SelectionMode="None" MaxHeight="140">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,6" ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent" Opacity="0.7">
                        <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0">
                            <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"
                                      IsChecked="{Binding IsDone, Mode=OneWay}"
                                      Style="{StaticResource CircleCheckBoxStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" />
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Click="UncompleteTask_Click"
                                    ToolTipService.ToolTip="Move back to To-do" />
                        </Grid>
                        <HyperlinkButton Grid.Column="1" Content="{Binding Title}"
                                         Click="OpenTask_Click"
                                         Padding="0" VerticalAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Left">
                            <HyperlinkButton.Resources>
                                <ResourceDictionary>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </Style>
                                </ResourceDictionary>
                            </HyperlinkButton.Resources>
                        </HyperlinkButton>
                        <Border Grid.Column="2" Style="{StaticResource ChipBorderStyle}"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding HasPriorityChip, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Priority}" Style="{StaticResource ChipTextStyle}" />
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource ChipBorderStyle}"
                                Background="{Binding DueUrgency, Converter={StaticResource DueBg}}"
                                Visibility="{Binding HasDue, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding DueChipText}" Style="{StaticResource ChipTextStyle}"
                                       Foreground="{Binding DueUrgency, Converter={StaticResource DueFg}}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Suggestions header -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="12" Margin="0,24,0,8">
            <TextBlock Text="Suggestions" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Button Content="Carry all" Click="CarryAll_Click" />
        </StackPanel>

        <!-- Suggestions list (slim — default) -->
        <ListView x:Name="SuggestionsList" Grid.Row="7" ItemsSource="{x:Bind ViewModel.Suggestions}" SelectionMode="None" MaxHeight="140">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,4" ColumnDefinitions="*,Auto">
                        <HyperlinkButton Grid.Column="0" Content="{Binding Title}"
                                         Click="OpenTask_Click"
                                         Padding="0" VerticalAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Left" />
                        <Button Grid.Column="1" Click="AddToDay_Click"
                                Background="Transparent" BorderThickness="0"
                                Padding="6" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding AddToMyDayLabel}"
                                ToolTipService.ToolTip="Add to My Day">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Suggestions list (rich — empty state only) -->
        <ListView x:Name="RichSuggestionsList" Grid.Row="7" Visibility="Collapsed"
                  ItemsSource="{x:Bind ViewModel.Suggestions}" SelectionMode="None" MaxHeight="400">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,8" RowDefinitions="Auto,Auto" Background="Transparent">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
                            <HyperlinkButton Grid.Column="0" Content="{Binding Title}"
                                             Click="OpenTask_Click"
                                             Padding="0" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Left" />
                            <Border Grid.Column="1" Style="{StaticResource ChipBorderStyle}"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{Binding HasPriorityChip, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Priority}" Style="{StaticResource ChipTextStyle}" />
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource ChipBorderStyle}"
                                    Background="{Binding DueUrgency, Converter={StaticResource DueBg}}"
                                    Visibility="{Binding HasDue, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding DueChipText}" Style="{StaticResource ChipTextStyle}"
                                           Foreground="{Binding DueUrgency, Converter={StaticResource DueFg}}" />
                            </Border>
                            <Button Grid.Column="3" Click="AddToDay_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0"
                                    AutomationProperties.Name="{Binding AddToMyDayLabel}"
                                    ToolTipService.ToolTip="Add to My Day">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="13" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="6" Margin="0,6,0,2"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding Subtasks}"
                                          Visibility="{Binding UseSegmentedBar, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="22" Height="6" CornerRadius="2"
                                                Background="{Binding Converter={StaticResource SegBrush}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                  Visibility="{Binding UseContinuousBar, Converter={StaticResource BoolVis}}">
                                <ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}"
                                           FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*"
                                  Visibility="{Binding HasCurrentStep, Converter={StaticResource BoolVis}}">
                                <Border Grid.Column="0" Width="3" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="1.5" Margin="0,1,8,1" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentStepText}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding BlurbPreview}"
                                       AutomationProperties.Name="{Binding BlurbPreview}"
                                       Opacity="0.8"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasBlurb, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

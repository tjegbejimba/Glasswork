<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glasswork.Pages.WorkLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Glasswork.Controls"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Grid Padding="32" RowDefinitions="Auto,*">

        <TextBlock
            Grid.Row="0"
            AutomationProperties.AutomationId="WorkLogHeader"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Work Log" />

        <TabView
            x:Name="WorkLogTabs"
            Grid.Row="1"
            Margin="0,16,0,0"
            AutomationProperties.AutomationId="WorkLogTabs"
            CanDragTabs="False"
            CanReorderTabs="False"
            IsAddTabButtonVisible="False"
            SelectionChanged="WorkLogTabs_SelectionChanged">
            <TabViewItem
                x:Name="CompletedTab"
                AutomationProperties.AutomationId="WorkLogCompletedTab"
                Header="Completed"
                IsClosable="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,8,0,16"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button Content="&#x25C0; Previous" Click="PrevWeek_Click" />
                        <TextBlock
                            x:Name="WeekLabel"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button Content="Next &#x25B6;" Click="NextWeek_Click" />
                        <Button Content="This Week" Click="ThisWeek_Click" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <Grid>
                            <TextBlock
                                x:Name="LogContent"
                                AutomationProperties.AutomationId="WorkLogContent"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                            <controls:EmptyState
                                x:Name="CompletedEmptyState"
                                Body="Mark tasks as in-progress or done across the week and they'll show up here as a tidy summary."
                                Glyph="&#xE9D5;"
                                Headline="No work logged this week."
                                Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Content="Copy to Clipboard" Click="Copy_Click" />
                        <Button Content="Save to Vault" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem
                x:Name="CancelledTab"
                AutomationProperties.AutomationId="WorkLogCancelledTab"
                Header="Cancelled"
                IsClosable="False">
                <Grid Margin="0,8,0,0">
                    <ListView
                        x:Name="CancelledTaskList"
                        AutomationProperties.AutomationId="CancelledTaskList"
                        ItemsSource="{x:Bind CancelledTasks}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="4">
                                            <Button
                                                AutomationProperties.AutomationId="OpenCancelledTaskButton"
                                                AutomationProperties.Name="{Binding OpenAccessibilityName}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OpenCancelledTask_Click"
                                                Content="{Binding Title}"
                                                DataContext="{Binding}"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Left"
                                                Padding="0" />
                                            <TextBlock
                                                AutomationProperties.AutomationId="CancelledTaskTimestamp"
                                                Opacity="0.7"
                                                Text="{Binding CancelledAtText}" />
                                            <TextBlock
                                                AutomationProperties.AutomationId="CancelledTaskReason"
                                                AutomationProperties.Name="{Binding ReasonText}"
                                                Text="{Binding ReasonText}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="RestoreCancelledTaskButton"
                                            AutomationProperties.Name="{Binding RestoreAccessibilityName}"
                                            Click="RestoreCancelledTask_Click"
                                            Content="Restore to Backlog"
                                            DataContext="{Binding}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <controls:EmptyState
                        x:Name="CancelledEmptyState"
                        AutomationProperties.AutomationId="CancelledEmptyState"
                        Body="Tasks you cancel will appear here and can be restored to Backlog."
                        Glyph="&#xE74D;"
                        Headline="No cancelled tasks."
                        Visibility="Collapsed" />
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>

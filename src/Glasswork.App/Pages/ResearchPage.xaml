<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glasswork.Pages.ResearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Glasswork.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
    <Grid
        x:Name="BackgroundContent"
        Padding="28"
        RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="ResearchHeader"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Research" />
                <TextBlock
                    Opacity="0.68"
                    Text="A focused library of explicitly opted-in Wiki Pages."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="ResearchAddTopicButton"
                Click="AddTopicButton_Click"
                Content="Add Topic"
                VerticalAlignment="Center" />
        </Grid>

        <Grid
            x:Name="PopulatedView"
            Grid.Row="1"
            Margin="0,20,0,0"
            ColumnDefinitions="3*,7*"
            ColumnSpacing="20"
            Visibility="Collapsed">
            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Margin="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <TextBox
                            x:Name="CatalogSearchBox"
                            AutomationProperties.AutomationId="ResearchCatalogSearchBox"
                            AutomationProperties.Name="Search Research Topics"
                            PlaceholderText="Search Topics"
                            TextChanged="CatalogFilter_Changed" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <ComboBox
                                x:Name="CatalogTypeFilter"
                                AutomationProperties.AutomationId="ResearchCatalogTypeFilter"
                                Header="Type"
                                SelectedIndex="0"
                                SelectionChanged="CatalogFilter_Changed">
                                <ComboBoxItem Content="All" Tag="" />
                                <ComboBoxItem Content="Concept" Tag="concept" />
                                <ComboBoxItem Content="Decision" Tag="decision" />
                                <ComboBoxItem Content="Entity" Tag="entity" />
                                <ComboBoxItem Content="Project" Tag="project" />
                                <ComboBoxItem Content="Source" Tag="source" />
                                <ComboBoxItem Content="System" Tag="system" />
                                <ComboBoxItem Content="Incident" Tag="incident" />
                                <ComboBoxItem Content="Accomplishment" Tag="accomplishment" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CatalogConfidenceFilter"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="ResearchCatalogConfidenceFilter"
                                Header="Confidence"
                                SelectedIndex="0"
                                SelectionChanged="CatalogFilter_Changed">
                                <ComboBoxItem Content="All" Tag="" />
                                <ComboBoxItem Content="High" Tag="high" />
                                <ComboBoxItem Content="Medium" Tag="medium" />
                                <ComboBoxItem Content="Low" Tag="low" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CatalogFreshnessFilter"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="ResearchCatalogFreshnessFilter"
                                Header="Freshness"
                                SelectedIndex="0"
                                SelectionChanged="CatalogFilter_Changed">
                                <ComboBoxItem Content="All" Tag="" />
                                <ComboBoxItem Content="Healthy" Tag="healthy" />
                                <ComboBoxItem Content="Low confidence" Tag="low" />
                                <ComboBoxItem Content="Expired" Tag="expired" />
                                <ComboBoxItem Content="Incomplete" Tag="incomplete" />
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <ListView
                        x:Name="TopicList"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="ResearchTopicList"
                        IsItemClickEnabled="True"
                        SelectionChanged="TopicList_SelectionChanged"
                        SelectionMode="Single"
                        SingleSelectionFollowsFocus="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="AutomationProperties.AutomationId" Value="ResearchTopicRow" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="14,11"
                                    RowDefinitions="Auto,Auto,Auto"
                                    AutomationProperties.ItemStatus="{Binding AccessibleStatus}"
                                    AutomationProperties.Name="{Binding Title}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock
                                            AutomationProperties.Name="{Binding Title}"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding Title}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            Opacity="0.75"
                                            Text="{Binding FreshnessLabel}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,5,0,0"
                                        MaxLines="1"
                                        Opacity="0.82"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,5,0,0"
                                        FontSize="11"
                                        Opacity="0.62"
                                        MaxLines="1"
                                        Text="{Binding MetadataLine}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid
                x:Name="TopicDetailView"
                Grid.Column="1"
                RowDefinitions="Auto,*"
                RowSpacing="12">
                <InfoBar
                    x:Name="TopicWarning"
                    AutomationProperties.AutomationId="ResearchMalformedWarning"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Latest refresh could not be read">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="ResearchRepairInObsidian"
                            Click="OpenInObsidianButton_Click"
                            Content="Open in Obsidian" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,280"
                    ColumnSpacing="24">
                <ScrollViewer
                    x:Name="TopicDetailScroll"
                    AutomationProperties.AutomationId="ResearchTopicDetail"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        HorizontalAlignment="Left"
                        MaxWidth="780"
                        Spacing="14">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                        <TextBlock
                            x:Name="TopicTitle"
                            AutomationProperties.AutomationId="ResearchTopicTitle"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Top">
                            <Button
                                x:Name="OpenInObsidianButton"
                                AutomationProperties.AutomationId="ResearchOpenInObsidian"
                                Click="OpenInObsidianButton_Click"
                                Content="Open in Obsidian" />
                            <Button
                                x:Name="RemoveFromResearchButton"
                                AutomationProperties.AutomationId="ResearchRemoveTopicButton"
                                Click="RemoveFromResearchButton_Click"
                                Content="Remove from Research" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="TopicType" Opacity="0.72" />
                        <TextBlock x:Name="TopicConfidence" Opacity="0.72" />
                        <TextBlock x:Name="TopicUpdated" Opacity="0.72" />
                        <TextBlock x:Name="TopicExpires" Opacity="0.72" />
                    </StackPanel>
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="10,7">
                        <TextBlock
                            x:Name="TopicFreshness"
                            AutomationProperties.AutomationId="ResearchFreshness"
                            FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Research Session" />
                        <Button
                            x:Name="PrimaryKnowledgeAction"
                            AutomationProperties.AutomationId="ResearchPrimaryAction"
                            Click="PrimaryKnowledgeAction_Click"
                            HorizontalAlignment="Left"
                            Style="{StaticResource AccentButtonStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="ResearchAddSourcesAction"
                                Click="AddSourcesAction_Click"
                                Content="Add sources" />
                            <Button
                                AutomationProperties.AutomationId="ResearchImprovePageAction"
                                Click="ImprovePageAction_Click"
                                Content="Improve this page" />
                        </StackPanel>
                        <InfoBar
                            x:Name="SessionClipboardHint"
                            AutomationProperties.AutomationId="ResearchSessionClipboardFeedback"
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="True"
                            IsOpen="False"
                            Message="Paste into Copilot CLI to begin the governed Research Session."
                            Severity="Success"
                            Title="Research Session command copied" />
                        <StackPanel
                            x:Name="OpenQuestionsPanel"
                            AutomationProperties.AutomationId="ResearchOpenQuestions"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Open Questions" />
                            <TextBlock
                                Opacity="0.68"
                                Text="Start a Research Session from a question without turning it into work."
                                TextWrapping="Wrap" />
                            <ItemsControl
                                x:Name="OpenQuestionsList"
                                AutomationProperties.AutomationId="ResearchOpenQuestionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="ResearchOpenQuestionAction"
                                            AutomationProperties.Name="{Binding AccessibleName}"
                                            Click="OpenQuestionAction_Click"
                                            Tag="{Binding}">
                                            <TextBlock
                                                MaxWidth="400"
                                                Text="{Binding Question}"
                                                TextWrapping="Wrap" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    <controls:VaultMarkdownView
                        x:Name="TopicMarkdown"
                        AutomationProperties.AutomationId="ResearchTopicMarkdown"
                        LinkClicked="TopicMarkdown_LinkClicked" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer
                    Grid.Column="1"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Border
                            x:Name="RelatedWorkPanel"
                            AutomationProperties.AutomationId="ResearchRelatedWorkPanel"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="Related Work" />
                                    <TextBlock
                                        Opacity="0.68"
                                        Text="Tasks stay independent from this Topic and keep their own live workflow state."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="CreateRelatedTaskButton"
                                        AutomationProperties.AutomationId="ResearchCreateTaskButton"
                                        Click="CreateRelatedTaskButton_Click"
                                        Content="Create Task" />
                                    <Button
                                        x:Name="LinkExistingTaskButton"
                                        AutomationProperties.AutomationId="ResearchLinkExistingTaskButton"
                                        Click="LinkExistingTaskButton_Click"
                                        Content="Link existing" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="RelatedWorkEmpty"
                                    AutomationProperties.AutomationId="ResearchRelatedWorkEmpty"
                                    Opacity="0.68"
                                    Text="No Tasks are linked to this Topic yet."
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    x:Name="ActiveRelatedWorkSection"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Opacity="0.72"
                                        Text="Active" />
                                    <ItemsControl
                                        x:Name="ActiveRelatedWorkList"
                                        AutomationProperties.AutomationId="ResearchActiveTaskList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Margin="0,0,0,6"
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="6">
                                                    <Button
                                                        AutomationProperties.AutomationId="ResearchRelatedTask"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        Click="RelatedTaskButton_Click"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        IsEnabled="{Binding CanNavigate}"
                                                        Padding="10,8"
                                                        Tag="{Binding}">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                MaxLines="2"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="Wrap"
                                                                ToolTipService.ToolTip="{Binding Title}" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Opacity="0.68"
                                                                Text="{Binding StatusLabel}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Grid.Column="1"
                                                        AutomationProperties.AutomationId="ResearchRepairTaskLink"
                                                        AutomationProperties.Name="{Binding RepairAccessibleName}"
                                                        Click="RepairRelatedTaskButton_Click"
                                                        Content="Repair"
                                                        Tag="{Binding}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding RepairVisibility}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Expander
                                    x:Name="CompletedRelatedWorkExpander"
                                    AutomationProperties.AutomationId="ResearchCompletedTasksExpander"
                                    IsExpanded="False"
                                    Visibility="Collapsed">
                                    <Expander.Header>
                                        <TextBlock
                                            x:Name="CompletedRelatedWorkHeader"
                                            FontWeight="SemiBold"
                                            Text="Completed" />
                                    </Expander.Header>
                                    <ItemsControl
                                        x:Name="CompletedRelatedWorkList"
                                        AutomationProperties.AutomationId="ResearchCompletedTaskList"
                                        Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Margin="0,0,0,6"
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="6">
                                                    <Button
                                                        AutomationProperties.AutomationId="ResearchRelatedCompletedTask"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        Click="RelatedTaskButton_Click"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        IsEnabled="{Binding CanNavigate}"
                                                        Padding="10,8"
                                                        Tag="{Binding}">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                MaxLines="2"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="Wrap"
                                                                ToolTipService.ToolTip="{Binding Title}" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Opacity="0.68"
                                                                Text="{Binding StatusLabel}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Grid.Column="1"
                                                        AutomationProperties.AutomationId="ResearchRepairTaskLink"
                                                        AutomationProperties.Name="{Binding RepairAccessibleName}"
                                                        Click="RepairRelatedTaskButton_Click"
                                                        Content="Repair"
                                                        Tag="{Binding}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding RepairVisibility}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <ItemsControl
                                    x:Name="RelatedWorkWarningsList"
                                    AutomationProperties.AutomationId="ResearchRelatedWorkWarnings">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,6"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="6"
                                                Padding="10,8">
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.78"
                                                        Text="{Binding Message}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="RelatedContextPanel"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="14"
                            VerticalAlignment="Top">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="Research context" />
                                    <TextBlock
                                        x:Name="ContextSummary"
                                        AutomationProperties.AutomationId="ResearchContextSummary"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Opacity="0.68"
                                        Text="The Topic is always included. Curate the durable default or narrow only the next Research Session."
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="CurateContextButton"
                                        AutomationProperties.AutomationId="ResearchCurateContext"
                                        Click="CurateContextButton_Click"
                                        Content="Curate context"
                                        HorizontalAlignment="Left" />
                                </StackPanel>
                                <ItemsControl x:Name="RelatedGroupsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12" Spacing="6">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Opacity="0.72"
                                                    Text="{Binding TypeLabel}" />
                                                <ItemsControl ItemsSource="{Binding Pages}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Margin="0,0,0,6"
                                                                Padding="10,8"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                AutomationProperties.AutomationId="ResearchRelatedPage"
                                                                AutomationProperties.Name="{Binding Title}"
                                                                Click="RelatedPageButton_Click"
                                                                Tag="{Binding}">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        MaxLines="2"
                                                                        Text="{Binding Title}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        TextWrapping="Wrap"
                                                                        ToolTipService.ToolTip="{Binding Title}" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Opacity="0.68"
                                                                        Text="{Binding MetadataLine}"
                                                                        TextWrapping="Wrap" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Opacity="0.68"
                                                                        Text="{Binding RelationLabel}"
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl x:Name="ContextWarningsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,6"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="6"
                                                Padding="10,8">
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.78"
                                                        Text="{Binding Message}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>
            <StackPanel
                x:Name="NoResultsView"
                Grid.Column="1"
                AutomationProperties.AutomationId="ResearchNoResults"
                HorizontalAlignment="Center"
                MaxWidth="420"
                Spacing="10"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Text="No Topics match your filters" />
                <TextBlock
                    Opacity="0.68"
                    Text="Try another search or clear the catalog filters."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="ResearchClearFiltersButton"
                    Click="ClearCatalogFilters_Click"
                    Content="Clear filters"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="EmptyStateView"
            Grid.Row="1"
            AutomationProperties.AutomationId="ResearchEmptyState"
            HorizontalAlignment="Center"
            MaxWidth="480"
            Spacing="12"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <FontIcon
                FontSize="42"
                Glyph="&#xE82D;"
                HorizontalAlignment="Center" />
            <TextBlock
                AutomationProperties.Name="No Research Topics yet"
                FontSize="22"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Text="No Research Topics yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.72"
                Text="Add Topic opts an existing schema-governed Wiki Page into this library. Glasswork does not create, move, or copy your knowledge."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="ResearchEmptyAddTopicButton"
                AutomationProperties.AutomationId="ResearchEmptyAddTopicButton"
                Click="AddTopicButton_Click"
                Content="Add Topic"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>

    <ContentControl
        x:Name="PreviewDrawerOverlay"
        AutomationProperties.AutomationId="ResearchPreviewDrawer"
        Background="#66000000"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Visibility="Collapsed">
        <ContentControl.KeyboardAccelerators>
            <KeyboardAccelerator
                Invoked="PreviewEscape_Invoked"
                Key="Escape" />
        </ContentControl.KeyboardAccelerators>
        <Border
            x:Name="PreviewDrawerPanel"
            Width="520"
            Padding="24"
            HorizontalAlignment="Right"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            TabFocusNavigation="Cycle">
            <Grid>
            <Grid
                x:Name="PreviewDrawerContent"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Opacity="0.68"
                            Text="Related Wiki Page" />
                        <TextBlock
                            x:Name="PreviewTitle"
                            AutomationProperties.AutomationId="ResearchPreviewTitle"
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="PreviewCloseButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ResearchPreviewClose"
                        AutomationProperties.Name="Close related page preview"
                        Click="PreviewCloseButton_Click"
                        Content="&#xE711;"
                        FontFamily="Segoe Fluent Icons"
                        VerticalAlignment="Top" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                    <Button
                        x:Name="PreviewPreviousButton"
                        AutomationProperties.AutomationId="ResearchPreviewPrevious"
                        Click="PreviewPreviousButton_Click"
                        Content="Previous" />
                    <Button
                        x:Name="PreviewNextButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ResearchPreviewNext"
                        Click="PreviewNextButton_Click"
                        Content="Next" />
                    <TextBlock
                        x:Name="PreviewMetadata"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Opacity="0.72"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="3"
                        AutomationProperties.AutomationId="ResearchPreviewOpenInObsidian"
                        Click="PreviewOpenInObsidianButton_Click"
                        Content="Open in Obsidian" />
                </Grid>

                <ScrollViewer
                    Grid.Row="2"
                    AutomationProperties.AutomationId="ResearchPreviewMarkdownScroll"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <controls:VaultMarkdownView
                        x:Name="PreviewMarkdown"
                        AutomationProperties.AutomationId="ResearchPreviewMarkdown"
                        LinkClicked="PreviewMarkdown_LinkClicked" />
                </ScrollViewer>
            </Grid>
            <Grid
                x:Name="ContextSelectionDrawerContent"
                AutomationProperties.AutomationId="ResearchContextDrawer"
                RowDefinitions="Auto,Auto,*,Auto"
                RowSpacing="16"
                Visibility="Collapsed">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="ContextSelectionEyebrow"
                            Opacity="0.68"
                            Text="Research Session" />
                        <TextBlock
                            x:Name="ContextSelectionTitle"
                            AutomationProperties.AutomationId="ResearchContextDrawerTitle"
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="ContextSelectionCloseButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ResearchContextDrawerClose"
                        AutomationProperties.Name="Close Research context drawer"
                        Click="ContextSelectionCloseButton_Click"
                        Content="&#xE711;"
                        FontFamily="Segoe Fluent Icons"
                        VerticalAlignment="Top" />
                </Grid>

                <TextBlock
                    x:Name="ContextSelectionExplanation"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="ResearchContextDrawerExplanation"
                    Opacity="0.78"
                    TextWrapping="Wrap" />

                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="ContextSelectionList"
                        AutomationProperties.AutomationId="ResearchContextSelectionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="0,0,0,8"
                                    Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="ResearchContextPageSelection"
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    Click="ContextSelectionCheckBox_Click"
                                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                                    IsEnabled="{Binding IsEnabled}"
                                    IsThreeState="False"
                                    Tag="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="11"
                                                Opacity="0.68"
                                                Text="{Binding Metadata}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Opacity="0.72"
                                            Text="{Binding StatusLabel}" />
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Spacing="10">
                    <InfoBar
                        x:Name="ContextSelectionError"
                        AutomationProperties.AutomationId="ResearchContextDrawerError"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock
                            x:Name="ContextSelectionSummary"
                            AutomationProperties.AutomationId="ResearchContextSelectionSummary"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ContextSelectionDoneButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ResearchContextSelectionDone"
                            Click="ContextSelectionDoneButton_Click"
                            Content="Copy command"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>
    </ContentControl>
    <ContentControl
        x:Name="RemoveTopicOverlay"
        AutomationProperties.AutomationId="ResearchRemoveTopicDialog"
        Background="#66000000"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Visibility="Collapsed">
        <ContentControl.KeyboardAccelerators>
            <KeyboardAccelerator
                Invoked="RemoveTopicEscape_Invoked"
                Key="Escape" />
        </ContentControl.KeyboardAccelerators>
        <Border
            Width="520"
            Padding="24"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            TabFocusNavigation="Cycle">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="Remove from Research?" />
                <TextBlock
                    x:Name="RemoveTopicPreserveMessage"
                    AutomationProperties.AutomationId="ResearchRemovePreserveWikiPageMessage"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.AutomationId="ResearchRemoveDeleteChangeLogMessage"
                    Text="Its Research Change Log will be permanently deleted. This cannot be undone."
                    TextWrapping="Wrap" />
                <TextBlock
                    Opacity="0.72"
                    Text="Adding this Wiki Page to Research again will start a new Change Log."
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RemoveTopicCancelButton"
                        AutomationProperties.AutomationId="ResearchRemoveCancelButton"
                        Click="RemoveTopicCancelButton_Click"
                        Content="Keep Topic" />
                    <Button
                        AutomationProperties.AutomationId="ResearchRemoveConfirmButton"
                        Click="RemoveTopicConfirmButton_Click"
                        Content="Remove from Research"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ContentControl>
    </Grid>
</Page>

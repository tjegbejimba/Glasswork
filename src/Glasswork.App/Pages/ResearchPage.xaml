<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glasswork.Pages.ResearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Glasswork.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="ResearchHeader"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Research" />
                <TextBlock
                    Opacity="0.68"
                    Text="A focused library of explicitly opted-in Wiki Pages."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="ResearchAddTopicButton"
                Click="AddTopicButton_Click"
                Content="Add Topic"
                VerticalAlignment="Center" />
        </Grid>

        <Grid
            x:Name="PopulatedView"
            Grid.Row="1"
            Margin="0,20,0,0"
            ColumnDefinitions="3*,7*"
            ColumnSpacing="20"
            Visibility="Collapsed">
            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Margin="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <TextBox
                            x:Name="CatalogSearchBox"
                            AutomationProperties.AutomationId="ResearchCatalogSearchBox"
                            AutomationProperties.Name="Search Research Topics"
                            PlaceholderText="Search Topics"
                            TextChanged="CatalogFilter_Changed" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <ComboBox
                                x:Name="CatalogTypeFilter"
                                AutomationProperties.AutomationId="ResearchCatalogTypeFilter"
                                Header="Type"
                                SelectedIndex="0"
                                SelectionChanged="CatalogFilter_Changed">
                                <ComboBoxItem Content="All" Tag="" />
                                <ComboBoxItem Content="Concept" Tag="concept" />
                                <ComboBoxItem Content="Decision" Tag="decision" />
                                <ComboBoxItem Content="Entity" Tag="entity" />
                                <ComboBoxItem Content="Project" Tag="project" />
                                <ComboBoxItem Content="Source" Tag="source" />
                                <ComboBoxItem Content="System" Tag="system" />
                                <ComboBoxItem Content="Incident" Tag="incident" />
                                <ComboBoxItem Content="Accomplishment" Tag="accomplishment" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CatalogConfidenceFilter"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="ResearchCatalogConfidenceFilter"
                                Header="Confidence"
                                SelectedIndex="0"
                                SelectionChanged="CatalogFilter_Changed">
                                <ComboBoxItem Content="All" Tag="" />
                                <ComboBoxItem Content="High" Tag="high" />
                                <ComboBoxItem Content="Medium" Tag="medium" />
                                <ComboBoxItem Content="Low" Tag="low" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CatalogFreshnessFilter"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="ResearchCatalogFreshnessFilter"
                                Header="Freshness"
                                SelectedIndex="0"
                                SelectionChanged="CatalogFilter_Changed">
                                <ComboBoxItem Content="All" Tag="" />
                                <ComboBoxItem Content="Healthy" Tag="healthy" />
                                <ComboBoxItem Content="Low confidence" Tag="low" />
                                <ComboBoxItem Content="Expired" Tag="expired" />
                                <ComboBoxItem Content="Incomplete" Tag="incomplete" />
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <ListView
                        x:Name="TopicList"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="ResearchTopicList"
                        IsItemClickEnabled="True"
                        SelectionChanged="TopicList_SelectionChanged"
                        SelectionMode="Single"
                        SingleSelectionFollowsFocus="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="AutomationProperties.AutomationId" Value="ResearchTopicRow" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="14,11"
                                    RowDefinitions="Auto,Auto,Auto"
                                    AutomationProperties.ItemStatus="{Binding AccessibleStatus}"
                                    AutomationProperties.Name="{Binding Title}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock
                                            AutomationProperties.Name="{Binding Title}"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding Title}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            Opacity="0.75"
                                            Text="{Binding FreshnessLabel}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,5,0,0"
                                        MaxLines="1"
                                        Opacity="0.82"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,5,0,0"
                                        FontSize="11"
                                        Opacity="0.62"
                                        MaxLines="1"
                                        Text="{Binding MetadataLine}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid
                x:Name="TopicDetailView"
                Grid.Column="1"
                RowDefinitions="Auto,*"
                RowSpacing="12">
                <InfoBar
                    x:Name="TopicWarning"
                    AutomationProperties.AutomationId="ResearchMalformedWarning"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Latest refresh could not be read">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="ResearchRepairInObsidian"
                            Click="OpenInObsidianButton_Click"
                            Content="Open in Obsidian" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <ScrollViewer
                    x:Name="TopicDetailScroll"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="ResearchTopicDetail"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        HorizontalAlignment="Left"
                        MaxWidth="780"
                        Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock
                            x:Name="TopicTitle"
                            AutomationProperties.AutomationId="ResearchTopicTitle"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="OpenInObsidianButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ResearchOpenInObsidian"
                            Click="OpenInObsidianButton_Click"
                            Content="Open in Obsidian"
                            VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="TopicType" Opacity="0.72" />
                        <TextBlock x:Name="TopicConfidence" Opacity="0.72" />
                        <TextBlock x:Name="TopicUpdated" Opacity="0.72" />
                        <TextBlock x:Name="TopicExpires" Opacity="0.72" />
                    </StackPanel>
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="10,7">
                        <TextBlock
                            x:Name="TopicFreshness"
                            AutomationProperties.AutomationId="ResearchFreshness"
                            FontWeight="SemiBold" />
                    </Border>
                    <Button
                        x:Name="PrimaryKnowledgeAction"
                        AutomationProperties.AutomationId="ResearchPrimaryAction"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Research Sessions are delivered by a successor slice." />
                    <controls:VaultMarkdownView
                        x:Name="TopicMarkdown"
                        AutomationProperties.AutomationId="ResearchTopicMarkdown"
                        LinkClicked="TopicMarkdown_LinkClicked" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <StackPanel
                x:Name="NoResultsView"
                Grid.Column="1"
                AutomationProperties.AutomationId="ResearchNoResults"
                HorizontalAlignment="Center"
                MaxWidth="420"
                Spacing="10"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Text="No Topics match your filters" />
                <TextBlock
                    Opacity="0.68"
                    Text="Try another search or clear the catalog filters."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="ResearchClearFiltersButton"
                    Click="ClearCatalogFilters_Click"
                    Content="Clear filters"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="EmptyStateView"
            Grid.Row="1"
            AutomationProperties.AutomationId="ResearchEmptyState"
            HorizontalAlignment="Center"
            MaxWidth="480"
            Spacing="12"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <FontIcon
                FontSize="42"
                Glyph="&#xE82D;"
                HorizontalAlignment="Center" />
            <TextBlock
                AutomationProperties.Name="No Research Topics yet"
                FontSize="22"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Text="No Research Topics yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.72"
                Text="Add Topic opts an existing schema-governed Wiki Page into this library. Glasswork does not create, move, or copy your knowledge."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.AutomationId="ResearchEmptyAddTopicButton"
                Click="AddTopicButton_Click"
                Content="Add Topic"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>

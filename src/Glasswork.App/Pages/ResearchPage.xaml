<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glasswork.Pages.ResearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Glasswork.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28" RowDefinitions="Auto,*">
        <StackPanel Spacing="4">
            <TextBlock
                AutomationProperties.AutomationId="ResearchHeader"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Research" />
            <TextBlock
                Opacity="0.68"
                Text="A focused library of explicitly opted-in Wiki Pages."
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid
            x:Name="PopulatedView"
            Grid.Row="1"
            Margin="0,20,0,0"
            ColumnDefinitions="3*,7*"
            ColumnSpacing="20"
            Visibility="Collapsed">
            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock
                        Margin="14,12,14,8"
                        FontWeight="SemiBold"
                        Text="Topics" />
                    <ListView
                        x:Name="TopicList"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="ResearchTopicList"
                        IsItemClickEnabled="True"
                        SelectionChanged="TopicList_SelectionChanged"
                        SelectionMode="Single"
                        SingleSelectionFollowsFocus="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="AutomationProperties.AutomationId" Value="ResearchTopicRow" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="14,11"
                                    RowDefinitions="Auto,Auto,Auto"
                                    AutomationProperties.ItemStatus="{Binding AccessibleStatus}"
                                    AutomationProperties.Name="{Binding Title}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock
                                            AutomationProperties.Name="{Binding Title}"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding Title}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            Opacity="0.75"
                                            Text="{Binding FreshnessLabel}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,5,0,0"
                                        MaxLines="1"
                                        Opacity="0.82"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,5,0,0"
                                        FontSize="11"
                                        Opacity="0.62"
                                        MaxLines="1"
                                        Text="{Binding MetadataLine}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid
                Grid.Column="1"
                RowDefinitions="Auto,*"
                RowSpacing="12">
                <InfoBar
                    x:Name="TopicWarning"
                    AutomationProperties.AutomationId="ResearchMalformedWarning"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Latest refresh could not be read">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="ResearchRepairInObsidian"
                            Click="OpenInObsidianButton_Click"
                            Content="Open in Obsidian" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <ScrollViewer
                    x:Name="TopicDetailScroll"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="ResearchTopicDetail"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        HorizontalAlignment="Left"
                        MaxWidth="780"
                        Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock
                            x:Name="TopicTitle"
                            AutomationProperties.AutomationId="ResearchTopicTitle"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="OpenInObsidianButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ResearchOpenInObsidian"
                            Click="OpenInObsidianButton_Click"
                            Content="Open in Obsidian"
                            VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="TopicType" Opacity="0.72" />
                        <TextBlock x:Name="TopicConfidence" Opacity="0.72" />
                        <TextBlock x:Name="TopicUpdated" Opacity="0.72" />
                        <TextBlock x:Name="TopicExpires" Opacity="0.72" />
                    </StackPanel>
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="10,7">
                        <TextBlock
                            x:Name="TopicFreshness"
                            AutomationProperties.AutomationId="ResearchFreshness"
                            FontWeight="SemiBold" />
                    </Border>
                    <Button
                        x:Name="PrimaryKnowledgeAction"
                        AutomationProperties.AutomationId="ResearchPrimaryAction"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Research Sessions are delivered by a successor slice." />
                    <controls:VaultMarkdownView
                        x:Name="TopicMarkdown"
                        AutomationProperties.AutomationId="ResearchTopicMarkdown"
                        LinkClicked="TopicMarkdown_LinkClicked" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <controls:EmptyState
            x:Name="EmptyStateView"
            Grid.Row="1"
            AutomationProperties.AutomationId="ResearchEmptyState"
            Body="Opt in an existing schema-governed Wiki Page with glasswork.research. The page stays in the Vault and is never copied into Glasswork."
            Glyph="&#xE82D;"
            Headline="No Research Topics yet"
            Visibility="Collapsed" />
    </Grid>
</Page>

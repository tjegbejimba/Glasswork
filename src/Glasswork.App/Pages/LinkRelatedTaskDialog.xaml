<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Glasswork.Pages.LinkRelatedTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Link existing Task"
    PrimaryButtonText="Link selected Task"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnLink">

    <Grid MinWidth="320" MaxWidth="560" RowDefinitions="Auto,Auto,320" RowSpacing="12">
        <InfoBar
            x:Name="LinkError"
            AutomationProperties.AutomationId="ResearchLinkTaskError"
            IsClosable="False"
            IsOpen="False"
            Severity="Error"
            Title="Unable to link Task" />
        <TextBox
            x:Name="TaskSearchBox"
            Grid.Row="1"
            AutomationProperties.AutomationId="ResearchLinkTaskSearchBox"
            Header="Search Tasks"
            PlaceholderText="Search by Task title or ID"
            TextChanged="TaskSearchBox_TextChanged" />
        <Grid Grid.Row="2">
            <ListView
                x:Name="TaskList"
                AutomationProperties.AutomationId="ResearchLinkTaskList"
                ContainerContentChanging="TaskList_ContainerContentChanging"
                IsItemClickEnabled="True"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="AutomationProperties.AutomationId" Value="ResearchLinkTaskRow" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="10,8"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="5"
                            ToolTipService.ToolTip="{Binding FullAncestry}">
                            <TextBlock
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{Binding Title}" />
                            <Border
                                Grid.Column="1"
                                MaxWidth="150"
                                Padding="7,2"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                VerticalAlignment="Top">
                                <TextBlock
                                    FontSize="11"
                                    Text="{Binding SourceKindBadge}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding SourceKindBadge}" />
                            </Border>
                            <Grid
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="10">
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.72"
                                    Text="{Binding NearestParentLabel}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding FullAncestry}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        FontSize="11"
                                        MaxWidth="120"
                                        Opacity="0.62"
                                        Text="{Binding TaskId}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding TaskId}" />
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.72"
                                        Text="{Binding StatusLabel}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="NoTaskMatches"
                HorizontalAlignment="Center"
                Opacity="0.68"
                Text="No Tasks match your search."
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</ContentDialog>

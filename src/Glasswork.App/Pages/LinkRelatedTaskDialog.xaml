<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Glasswork.Pages.LinkRelatedTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Link existing Task"
    PrimaryButtonText="Link selected Task"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnLink">

    <Grid MinWidth="460" RowDefinitions="Auto,Auto,320" RowSpacing="12">
        <InfoBar
            x:Name="LinkError"
            AutomationProperties.AutomationId="ResearchLinkTaskError"
            IsClosable="False"
            IsOpen="False"
            Severity="Error"
            Title="Unable to link Task" />
        <TextBox
            x:Name="TaskSearchBox"
            Grid.Row="1"
            AutomationProperties.AutomationId="ResearchLinkTaskSearchBox"
            Header="Search Tasks"
            PlaceholderText="Search by Task title or ID"
            TextChanged="TaskSearchBox_TextChanged" />
        <Grid Grid.Row="2">
            <ListView
                x:Name="TaskList"
                AutomationProperties.AutomationId="ResearchLinkTaskList"
                IsItemClickEnabled="True"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="AutomationProperties.AutomationId" Value="ResearchLinkTaskRow" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="10,8"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTipService.ToolTip="{Binding Title}" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.68"
                                    Text="{Binding TaskId}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                FontSize="11"
                                Opacity="0.72"
                                Text="{Binding StatusLabel}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="NoTaskMatches"
                HorizontalAlignment="Center"
                Opacity="0.68"
                Text="No Tasks match your search."
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</ContentDialog>

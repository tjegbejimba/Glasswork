<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glasswork.Pages.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Glasswork.Converters"
    xmlns:viewmodels="using:Glasswork.ViewModels"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolVisibilityConverter x:Key="BoolVis" />

        <DataTemplate x:Key="ReviewItemTemplate" x:DataType="viewmodels:ReviewItemRow">
            <Border
                Margin="0,0,0,12"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <CheckBox
                            AutomationProperties.AutomationId="{x:Bind SelectionAutomationId}"
                            VerticalAlignment="Top"
                            IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                            Tag="{x:Bind ItemId}"
                            Click="ToggleSelection_Click" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Summary}" TextWrapping="WrapWholeWords" />
                            <TextBlock Opacity="0.75" Text="{x:Bind ProposalTypeLabel}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Opacity="0.7"
                            Text="{x:Bind GeneratedAtText}" />
                    </Grid>

                    <TextBlock Text="{x:Bind ProposedValue}" TextWrapping="WrapWholeWords" />
                    <TextBlock Opacity="0.85" Text="{x:Bind Rationale}" TextWrapping="WrapWholeWords" />
                    <TextBlock Opacity="0.75" Text="{x:Bind MatchingEvidence}" TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Visibility="{x:Bind HasAttendanceLabel, Mode=OneWay, Converter={StaticResource BoolVis}}"
                        Opacity="0.75"
                        Text="{x:Bind AttendanceLabel}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Opacity="0.65" Text="{x:Bind SourceTitle}" />
                        <Button
                            Visibility="{x:Bind HasSourceLink, Mode=OneWay, Converter={StaticResource BoolVis}}"
                            Content="Open recap"
                            Tag="{x:Bind SourceUrl}"
                            Click="OpenSourceLink_Click" />
                    </StackPanel>

                    <TextBlock
                        Visibility="{x:Bind HasApplyFailure, Mode=OneWay, Converter={StaticResource BoolVis}}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ApplyFailureText}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReviewGroupTemplate" x:DataType="viewmodels:ReviewTaskGroup">
            <Expander
                AutomationProperties.AutomationId="{x:Bind GroupAutomationId}"
                Margin="0,0,0,12"
                IsExpanded="{x:Bind StartsExpanded, Mode=OneTime}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind TaskTitle}" />
                        <TextBlock Opacity="0.65" Text="{x:Bind TaskId}" />
                        <TextBlock Opacity="0.65" Text="{x:Bind ItemCountText}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemTemplate="{StaticResource ReviewItemTemplate}" ItemsSource="{x:Bind Items}" />
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="ReviewHistoryTemplate" x:DataType="viewmodels:ReviewHistoryRow">
            <Border
                Margin="0,0,0,8"
                Padding="10"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Summary}" TextWrapping="WrapWholeWords" />
                    <TextBlock Opacity="0.7" Text="{x:Bind ProposedValue}" TextWrapping="WrapWholeWords" />
                    <TextBlock Opacity="0.7" Text="{x:Bind SourceTitle}" />
                    <TextBlock
                        Visibility="{x:Bind HasAttendanceLabel, Mode=OneWay, Converter={StaticResource BoolVis}}"
                        Opacity="0.7"
                        Text="{x:Bind AttendanceLabel}" />
                    <TextBlock Opacity="0.65" Text="{x:Bind ProposalTypeLabel}" />
                    <TextBlock Opacity="0.65" Text="{x:Bind DispositionLabel}" />
                    <TextBlock Opacity="0.65" Text="{x:Bind DisposedAtText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SourceHealthTemplate" x:DataType="viewmodels:ReviewSourceHealthRow">
            <Border
                Margin="0,0,0,8"
                Padding="10"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind SourceId}" />
                    <TextBlock Text="{x:Bind LastAttemptText}" />
                    <TextBlock Text="{x:Bind LastSuccessfulRunText}" />
                    <TextBlock Text="{x:Bind ConsecutiveFailuresText}" />
                    <ItemsControl ItemsSource="{x:Bind Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,2" Opacity="0.8" Text="{Binding Message}" TextWrapping="WrapWholeWords" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowDefinitions="Auto,Auto,*">
        <TextBlock
            Grid.Row="0"
            AutomationProperties.AutomationId="ReviewHeader"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Review" />

        <StackPanel Grid.Row="1" Margin="0,16,0,16" Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="ApproveSelectedButton"
                AutomationProperties.AutomationId="ReviewApproveSelectedButton"
                Click="ApproveSelected_Click"
                Content="{x:Bind ViewModel.Approval.ActionLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.Approval.CanApprove, Mode=OneWay}" />
            <Button
                x:Name="RejectSelectedButton"
                AutomationProperties.AutomationId="ReviewRejectSelectedButton"
                Click="RejectSelected_Click"
                Content="Reject selected"
                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="16">
                <InfoBar
                    x:Name="RecoveryWarningBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Queue recovery needs acknowledgement">
                    <InfoBar.ActionButton>
                        <Button Content="Acknowledge" Click="AcknowledgeRecovery_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border x:Name="SourceHealthPanel" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Source health" />
                        <ItemsControl ItemTemplate="{StaticResource SourceHealthTemplate}" ItemsSource="{x:Bind ViewModel.SourceHealthEntries, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="ApprovalBlockedText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />

                <StackPanel x:Name="PendingSection" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Pending" />
                    <ItemsControl ItemTemplate="{StaticResource ReviewGroupTemplate}" ItemsSource="{x:Bind ViewModel.PendingGroups, Mode=OneWay}" />
                </StackPanel>

                <Expander
                    x:Name="WaitingForRefreshSection"
                    AutomationProperties.AutomationId="ReviewWaitingForRefreshSection"
                    Header="Waiting for refresh"
                    IsExpanded="False"
                    Visibility="Collapsed">
                    <ItemsControl ItemTemplate="{StaticResource ReviewGroupTemplate}" ItemsSource="{x:Bind ViewModel.WaitingForRefreshGroups, Mode=OneWay}" />
                </Expander>

                <StackPanel x:Name="HistorySection" Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="History" />
                    <ItemsControl
                        x:Name="ReviewHistoryList"
                        ItemTemplate="{StaticResource ReviewHistoryTemplate}"
                        ItemsSource="{x:Bind ViewModel.HistoryItems, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
